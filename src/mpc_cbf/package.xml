<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpc_cbf</name>
  <version>0.2.2</version>
  <description>
    Timestamped RGB-D human tracking integration with world-frame identity
    recovery, uncertainty-aware prediction, and robust MPC-DCBF control.
  </description>

  <maintainer email="chetandahal80@users.noreply.github.com">Chetan Dahal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>human_tracking</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-cvxpy</exec_depend>
  <exec_depend>python3-osqp</exec_depend>


  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
</package>
